# ===================================================
# HOSTCONTROL ENVIRONMENT CONFIGURATION (.env)
# ===================================================

# Application Environment
NODE_ENV=production
PORT=4000

# Next.js Internal Backend Rewrite URL (used during server rewrites)
BACKEND_INTERNAL_URL=http://127.0.0.1:4000

# Public API URL (optional - leave empty or set to /api/v1 for relative proxy)
NEXT_PUBLIC_API_URL=/api/v1

# Security & Tokens
JWT_SECRET=techsolutionor_super_secure_jwt_secret_key_2026_xyz
JWT_REFRESH_SECRET=techsolutionor_super_secure_refresh_secret_2026_xyz
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database Selection: "sqlite" for quick zero-config setup, or "postgres" for high performance
DB_DIALECT=sqlite
SQLITE_STORAGE=./backend/storage/production.db

# Postgres Settings (Used only if DB_DIALECT=postgres)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hostcontrol_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_postgres_password

# External Mail & DNS Drivers (Optional / Mock mode by default)
MAILCOW_API_URL=https://mail.techsolutionor.com/api/v1
MAILCOW_API_KEY=your_mailcow_api_key_here
POWERDNS_API_URL=http://127.0.0.1:8081/api/v1
POWERDNS_API_KEY=your_powerdns_api_key_here



