# ===================================================
# HOSTCONTROL ENVIRONMENT CONFIGURATION (.env)
# ===================================================

# Application Environment
NODE_ENV=production
PORT=4000

# Next.js Internal Backend Rewrite URL
BACKEND_INTERNAL_URL=http://127.0.0.1:4000
NEXT_PUBLIC_API_URL=/api/v1

# Security & Tokens
JWT_SECRET=techsolutionor_super_secure_jwt_secret_key_2026_xyz
JWT_REFRESH_SECRET=techsolutionor_super_secure_refresh_secret_2026_xyz
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ----------------------------------------------------
# DATABASE CONFIGURATION
# Options: "mysql" (Recommended), "sqlite", "postgres"
# ----------------------------------------------------
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hostcontrol_db
DB_USER=techadmin
DB_PASSWORD=Admin@123456

# SQLite Settings (Used only if DB_DIALECT=sqlite)
SQLITE_STORAGE=./backend/storage/production.db

# External Mail & DNS Drivers (Mock mode by default)
MAILCOW_API_URL=https://mail.techsolutionor.com/api/v1
MAILCOW_API_KEY=your_mailcow_api_key_here
POWERDNS_API_URL=http://127.0.0.1:8081/api/v1
POWERDNS_API_KEY=your_powerdns_api_key_here
